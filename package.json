{
  "name": "threadshelf",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome side panel for finding existing ChatGPT and Google Search AI Mode conversations; setup baseline.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "build": "wxt build -b chrome",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  }
}
